{
  "name": "@xex/tailwind-preset",
  "version": "0.1.0",
  "description": "Tailwind CSS preset for the XeX design system: theme-driven brand colour scale and fonts.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.0"
  }
}
