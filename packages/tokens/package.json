{
  "name": "@xex/tokens",
  "version": "0.3.0",
  "description": "XeX design tokens: colour themes, font helpers and the shared stylesheet.",
  "license": "MIT",
  "keywords": [
    "design-system",
    "design-tokens",
    "themes",
    "tailwind"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iGattreX/XeX.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/iGattreX/XeX#readme",
  "bugs": {
    "url": "https://github.com/iGattreX/XeX/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/gen-css.mjs && tailwindcss -c tailwind.styles.config.js -i src/styles.src.css -o dist/styles.css && tsup",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@xex/tailwind-preset": "^0.3.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
