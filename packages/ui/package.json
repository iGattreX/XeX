{
  "name": "@xex/ui",
  "version": "0.1.0",
  "description": "XeX design system: React components, app shell and theme provider.",
  "license": "MIT",
  "keywords": [
    "react",
    "components",
    "design-system",
    "tailwind",
    "theming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iGattreX/xex.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/iGattreX/xex#readme",
  "bugs": {
    "url": "https://github.com/iGattreX/xex/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./font-picker": {
      "types": "./dist/font-picker.d.ts",
      "import": "./dist/font-picker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@xex/tokens": "^0.1.0",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
